# منارة (Manarah) — server environment variables
#
# Copy to .env.local for local development. Never commit real values.
# All of these are read and validated once at startup by lib/server/env.ts —
# the app fails fast with a clear error if any required variable is missing
# or malformed, rather than failing later inside a request.

# Neon Postgres connection string for the Manarah *development* branch.
# Get this from the Neon Console (or `mcp__Neon__get_connection_string`) for
# project floral-moon-71784097, branch br-silent-mouse-aygp5gh6 (development).
# NEVER point this at the `production` branch, or at the `innvo` /
# `innovation-platform` projects — see docs/architecture/manarah-phase4-report.md.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require"

# Neon Auth (Managed Better Auth) base URL for the same branch.
# From provision_neon_auth / get_neon_auth_config — see the Phase 4 report.
NEON_AUTH_BASE_URL="https://ep-falling-band-aypehutc.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth"

# Secret used to sign the session_data cache cookie minted by the Neon Auth
# Next.js adapter. Minimum 32 characters. Generate with: openssl rand -base64 32
# This is NOT the Neon Auth server's own secret — it's local to this app.
NEON_AUTH_COOKIE_SECRET="replace-with-a-real-32-plus-character-secret"

# Optional: object storage for attachments (Phase 5 implements the metadata
# columns only — storage_provider/storage_bucket/storage_key — and does not
# select a vendor or perform real uploads/signed-URL generation yet, per the
# approved Phase 3/4 decision. These are placeholders for when that lands.)
# ATTACHMENTS_STORAGE_PROVIDER="s3"
# ATTACHMENTS_STORAGE_BUCKET=""
